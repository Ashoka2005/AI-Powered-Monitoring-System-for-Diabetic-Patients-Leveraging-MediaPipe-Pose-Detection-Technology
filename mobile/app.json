{
  "expo": {
    "name": "DiaFit AI",
    "slug": "diafit-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diafitai.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "DiaFit AI uses your camera for exercise pose detection.",
        "NSMicrophoneUsageDescription": "DiaFit AI uses your microphone for voice commands."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "package": "com.diafitai.mobile",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      "expo-camera",
      "expo-av",
      "expo-secure-store"
    ]
  }
}
