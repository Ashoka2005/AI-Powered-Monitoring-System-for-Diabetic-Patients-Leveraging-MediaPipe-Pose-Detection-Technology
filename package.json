{
  "name": "diafit-ai",
  "version": "1.0.0",
  "description": "AI-powered healthcare platform with diabetes management, fitness tracking, and pose detection",
  "private": true,
  "scripts": {
    "backend": "cd backend && node server.js",
    "backend:dev": "cd backend && npx nodemon server.js",
    "build": "cd frontend && npm install && npm run build",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "ml-service": "cd ml-service && python app.py",
    "mobile": "cd mobile && npx expo start",
    "seed": "cd backend && node src/utils/seed.js",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "install:mobile": "cd mobile && npm install",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "start": "start.bat",
    "dev": "start.bat"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.7.5"
  },
  "keywords": ["healthcare", "diabetes", "fitness", "ai", "pose-detection", "mediapipe"],
  "author": "DiaFit AI Team",
  "license": "MIT"
}
