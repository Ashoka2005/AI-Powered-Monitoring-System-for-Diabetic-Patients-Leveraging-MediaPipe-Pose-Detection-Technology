# ===================================
# DiaFit AI - Environment Configuration
# ===================================
# Copy this file to .env and fill in your values

# ─── Backend ───
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/diafit-ai

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRE=30d

# ML Service
ML_SERVICE_URL=http://localhost:5001

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@diafitai.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# IoT
IOT_WEBHOOK_SECRET=your-iot-secret

# ─── Frontend ───
VITE_API_URL=/api/v1

# ─── Mobile ───
# API_BASE_URL=http://YOUR_SERVER_IP:5000/api/v1
